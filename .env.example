# Alpaca paper keys — https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADE_URL=https://paper-api.alpaca.markets
ALPACA_FEED=iex

# Slack incoming webhook — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Pushover — create an application at https://pushover.net/apps/build
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Timed check reminders go to this application and channel, not the rule destinations.
# SLACK_WEBHOOK_IMPORTANT_REMINDER=
# PUSHOVER_TOKEN_IMPORTANT_REMINDER=

# Per-rule destinations. A Slack incoming webhook is locked to one channel, so each
# rule needs its own webhook. Each Pushover token is a separate app; PUSHOVER_USER
# stays the one above. Names match the notify field in config/rules.yaml.
# OpenD disconnects, rate limits, and scan errors use these. Otherwise they use the defaults above.
# SLACK_WEBHOOK_OPEND=
# PUSHOVER_TOKEN_OPEND=
# SLACK_WEBHOOK_AFTERHOURS_TOP5=
# PUSHOVER_TOKEN_AFTERHOURS_TOP5=
# SLACK_WEBHOOK_REGULAR_TOP5=
# PUSHOVER_TOKEN_REGULAR_TOP5=
# SLACK_WEBHOOK_PREMARKET_TOP5=
# PUSHOVER_TOKEN_PREMARKET_TOP5=
# SLACK_WEBHOOK_AFTERHOURS_AH50=
# PUSHOVER_TOKEN_AFTERHOURS_AH50=
# SLACK_WEBHOOK_REGULAR_AH50=
# PUSHOVER_TOKEN_REGULAR_AH50=
# SLACK_WEBHOOK_PREMARKET_AH50=
# PUSHOVER_TOKEN_PREMARKET_AH50=
# SLACK_WEBHOOK_HALT_BOOST=
# PUSHOVER_TOKEN_HALT_BOOST=
# SLACK_WEBHOOK_5_DAY_PREMARKET_BOOST=
# PUSHOVER_TOKEN_5_DAY_PREMARKET_BOOST=
# SLACK_WEBHOOK_5_DAY_AFTERHOURS_BOOST=
# PUSHOVER_TOKEN_5_DAY_AFTERHOURS_BOOST=
# SLACK_WEBHOOK_PREMARKET_SUDDEN_10=
# PUSHOVER_TOKEN_PREMARKET_SUDDEN_10=
# SLACK_WEBHOOK_REGULAR_SUDDEN_10=
# PUSHOVER_TOKEN_REGULAR_SUDDEN_10=
# SLACK_WEBHOOK_AFTERHOURS_SUDDEN_10=
# PUSHOVER_TOKEN_AFTERHOURS_SUDDEN_10=
# Halt/80% board + AH>5% singles share Halt-boost (see afterhours-halt-or-day80).

# 同花顺 account. Alerted names go to the rule's group and 盘前/盘中/盘后分组. Leave blank to skip.
THS_USERNAME=
THS_PASSWORD=

# Moomoo OpenD must be logged in. Default local gateway.
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
