# The monitor reloads this file on every poll, so you can change rules without restarting.

# 盘中涨超30%用 poll。回撤、盘后涨幅、最后2小时仍扫榜。
# 半点榜 *-top5：按该时段最高涨幅取前5（盘后另加 16:10 ET≈10:10 NZ）。成交量超10万（各时段开盘槽除外；5日与熔断/80%为1万）。总市值超过100万美元。
# 熔断/80%：半点在池内按盘后涨幅取前5；盘中首次进池就推，盘后首次超5%再推。走势在收盘前记下。5日在收盘后按当天涨幅记下超过50%、总市值超过100万美元且不超过10亿美元、成交量超过1万的股票。场外（OTC）不参与任何条件。
poll_interval_seconds: 2
scanner_interval_seconds: 2
background_scan_interval_seconds: 5
poll_when_closed: true
# Alpaca only. Moomoo ignores these.
