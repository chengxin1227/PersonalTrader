# Alpaca paper keys — https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADE_URL=https://paper-api.alpaca.markets
ALPACA_FEED=iex

# Slack — off by default (Pushover only). Set true and fill webhooks to enable.
SLACK_ENABLED=false
# Slack incoming webhook — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Pushover — create three apps at https://pushover.net/apps/build named exactly:
#   今日盘前自选 / 今日盘中自选 / 今日盘后自选
# Session alerts use the matching app (From = app name). PUSHOVER_USER is shared.
PUSHOVER_USER=
# Fallback when session is unknown (OpenD / closed); usually same as AFTERHOURS.
PUSHOVER_TOKEN=
PUSHOVER_TOKEN_PREMARKET=
PUSHOVER_TOKEN_REGULAR=
PUSHOVER_TOKEN_AFTERHOURS=

# Optional Slack per-notify webhooks when SLACK_ENABLED=true (names match rules.yaml notify).
# SLACK_WEBHOOK_OPEND=
# SLACK_WEBHOOK_AFTERHOURS_TOP5=
# SLACK_WEBHOOK_IMPORTANT_REMINDER=

# 同花顺 account. Alerted names go to the rule's group and 今日自选. Leave blank to skip.
THS_USERNAME=
THS_PASSWORD=

# Moomoo OpenD must be logged in. Default local gateway.
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
