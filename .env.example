# Alpaca paper keys — https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADE_URL=https://paper-api.alpaca.markets
ALPACA_FEED=iex

# Slack incoming webhook — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Pushover — create an application at https://pushover.net/apps/build
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Per-rule destinations. A Slack incoming webhook is locked to one channel, so each
# rule needs its own webhook. Each Pushover token is a separate app; PUSHOVER_USER
# stays the one above. Names match the notify field in config/rules.yaml.
# OpenD disconnects, rate limits, and scan errors use these. Otherwise they use the defaults above.
# SLACK_WEBHOOK_OPEND=
# PUSHOVER_TOKEN_OPEND=
# SLACK_WEBHOOK_PREMARKET_BOOST=
# PUSHOVER_TOKEN_PREMARKET_BOOST=
# SLACK_WEBHOOK_AFTERHOURS_BOOST=
# PUSHOVER_TOKEN_AFTERHOURS_BOOST=
# SLACK_WEBHOOK_DAY_30_BOOST=
# PUSHOVER_TOKEN_DAY_30_BOOST=
# SLACK_WEBHOOK_TREND_BOOST=
# PUSHOVER_TOKEN_TREND_BOOST=
# SLACK_WEBHOOK_HALT_BOOST=
# PUSHOVER_TOKEN_HALT_BOOST=
# SLACK_WEBHOOK_5_DAY_PREMARKET_BOOST=
# PUSHOVER_TOKEN_5_DAY_PREMARKET_BOOST=
# SLACK_WEBHOOK_5_DAY_AFTERHOURS_BOOST=
# PUSHOVER_TOKEN_5_DAY_AFTERHOURS_BOOST=
# SLACK_WEBHOOK_LAST_HOUR_BOOST=
# PUSHOVER_TOKEN_LAST_HOUR_BOOST=
# SLACK_WEBHOOK_TOP_5_AFTERHOURS_BOOST=
# PUSHOVER_TOKEN_TOP_5_AFTERHOURS_BOOST=

# Moomoo OpenD must be logged in. Default local gateway.
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
